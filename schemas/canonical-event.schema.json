{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AvaTar-ArTs/iterm2/schemas/canonical-event.schema.json",
  "title": "WorkVault Canonical Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "observed_at",
    "actor",
    "evidence",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "workvault-event/v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_.-]+$",
      "examples": [
        "session.started",
        "run.completed",
        "artifact.verified",
        "decision.recorded",
        "incident.detected",
        "source.blocked",
        "path.symlinked",
        "drift.detected"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": ["string", "null"],
      "format": "date-time",
      "default": null
    },
    "valid_to": {
      "type": ["string", "null"],
      "format": "date-time",
      "default": null
    },
    "project_id": {
      "type": ["string", "null"],
      "default": null
    },
    "workstream_id": {
      "type": ["string", "null"],
      "default": null
    },
    "session_id": {
      "type": ["string", "null"],
      "default": null
    },
    "run_id": {
      "type": ["string", "null"],
      "default": null
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "user",
            "agent",
            "tool",
            "system",
            "external_source",
            "derived"
          ]
        },
        "id": {
          "type": ["string", "null"],
          "default": null
        },
        "provider": {
          "type": ["string", "null"],
          "default": null
        },
        "model": {
          "type": ["string", "null"],
          "default": null
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "confidence"],
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "user_assertion",
            "tool_observation",
            "filesystem_observation",
            "git_observation",
            "test_result",
            "external_source",
            "agent_inference",
            "assistant_statement",
            "derived_computation"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_ref": {
          "type": ["string", "null"],
          "default": null
        }
      }
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "SENSITIVE",
        "SECRET",
        "DO_NOT_INGEST"
      ],
      "default": "INTERNAL"
    },
    "ownership_mode": {
      "type": ["string", "null"],
      "enum": ["MANAGED", "REFERENCED", "EPHEMERAL", null],
      "default": null
    },
    "payload": {
      "type": "object"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    }
  }
}
